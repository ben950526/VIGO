{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["sin1"],
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/admin-review-digest",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/weekly-milestone",
      "schedule": "0 1 * * 1"
    },
    {
      "path": "/api/cron/threads-post",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/threads-post",
      "schedule": "0 13 * * *"
    }
  ]
}
